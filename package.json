{
    "name": "hedera-consensus-3d",
    "private": true,
    "version": "1.0.0",
    "description": "Live 3D view of Hedera mainnet consensus: real nodes, stake and every transaction at its consensus timestamp, streamed from the public mirror node.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write src"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "three": "^0.187.0",
        "topojson-client": "^3.1.0",
        "world-atlas": "^2.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.187.0",
        "@types/topojson-client": "^3.1.5",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6"
    }
}
